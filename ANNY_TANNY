    // ============================================================
    // UI HELPERS
    // ============================================================
    function addSlider(parent, label, mn, mx, val, step, onChange) {
        var row = parent.add("group");
        row.orientation = "row";
        row.alignment = ["fill","top"];
        var lbl = row.add("statictext", undefined, label + ":");
        lbl.preferredSize.width = 110;
        var sld = row.add("slider", undefined, val, mn, mx);
        sld.preferredSize.width = 130;
        var box = row.add("edittext", undefined, (step >= 1) ? String(val) : Number(val).toFixed(2));
        box.preferredSize.width = 50;
        sld.onChanging = function(){
            var v = (step >= 1) ? Math.round(sld.value) : Math.round(sld.value/step)*step;
            box.text = (step >= 1) ? String(v) : v.toFixed(2);
            onChange(v);
        };
        box.onChange = function(){
            var v = parseFloat(box.text);
            if (isNaN(v)) return;
            v = clamp(v, mn, mx);
            sld.value = v;
            box.text = (step >= 1) ? String(Math.round(v)) : v.toFixed(2);
            onChange(v);
        };
    }

    function addColor(parent, label, val, onChange) {
        var row = parent.add("group");
        row.orientation = "row";
        var lbl = row.add("statictext", undefined, label + ":");
        lbl.preferredSize.width = 110;
        var sw = row.add("button", undefined, "");
        sw.preferredSize = [40, 22];
        sw.fillBrush = sw.graphics.newBrush(sw.graphics.BrushType.SOLID_COLOR, val);
        sw.onDraw = function(){
            sw.graphics.rectPath(0, 0, sw.size[0], sw.size[1]);
            sw.graphics.fillPath(sw.fillBrush);
        };
        sw.onClick = function(){
            var c = $.colorPicker();
            if (c < 0) return;
            var r = ((c >> 16) & 0xFF)/255;
            var g = ((c >> 8)  & 0xFF)/255;
            var b = (c & 0xFF)/255;
            val = [r,g,b];
            sw.fillBrush = sw.graphics.newBrush(sw.graphics.BrushType.SOLID_COLOR, val);
            sw.notify("onDraw");
            onChange(val);
        };
    }

    function divider(parent) {
        var d = parent.add("panel");
        d.alignment = ["fill","top"];
        d.preferredSize.height = 2;
    }

    // ============================================================
    // MAIN UI
    // ============================================================
    function buildUI(thisObj) {
        var w = (thisObj instanceof Panel)
            ? thisObj
            : new Window("palette", SCRIPT_NAME + " " + SCRIPT_VERSION, undefined, {resizeable:true});
        w.orientation = "column";
        w.alignChildren = ["fill","top"];
        w.spacing = 6;
        w.margins = 10;
        w.preferredSize.width = 340;


        var title = w.add("statictext", undefined, SCRIPT_NAME + "  " + SCRIPT_VERSION);
        title.graphics.foregroundColor = title.graphics.newPen(title.graphics.PenType.SOLID_COLOR, COL.accent, 1);

        // Animation selector
        var modeRow = w.add("group");
        modeRow.orientation = "row";
        var ml = modeRow.add("statictext", undefined, "Animation:"); ml.preferredSize.width = 70;
        var dd = modeRow.add("dropdownlist", undefined, []);
        for (var i = 0; i < ANIMATIONS.length; i++) dd.add("item", ANIMATIONS[i].name);
        dd.selection = 0;
        dd.preferredSize.width = 160;

        // Easing selector
        var easeRow = w.add("group");
        easeRow.orientation = "row";
        var el = easeRow.add("statictext", undefined, "Easing:"); el.preferredSize.width = 70;
        var ddEase = easeRow.add("dropdownlist", undefined, EASING_NAMES);
        ddEase.selection = 1; // Ease Out default
        ddEase.preferredSize.width = 160;

        divider(w);

        var paramsPanel = w.add("group");
        paramsPanel.orientation = "column";
        paramsPanel.alignChildren = ["fill","top"];

        var states = [];
        for (var s = 0; s < ANIMATIONS.length; s++) {
            var st = {};
            for (var key in ANIMATIONS[s].defaults) st[key] = ANIMATIONS[s].defaults[key];
            states.push(st);
        }

        function rebuildParams() {
            while (paramsPanel.children.length > 0) paramsPanel.remove(paramsPanel.children[0]);
            var idx = dd.selection.index;
            ANIMATIONS[idx].buildParams(paramsPanel, states[idx]);

            // sync easing dropdown with state
            var foundEase = ddEase.find(states[idx].easing);
            if (foundEase) ddEase.selection = foundEase;

            // Loop checkbox + cycle slider
            var loopRow = paramsPanel.add("group");
            loopRow.orientation = "row";
            var llabel = loopRow.add("statictext", undefined, "Loop:"); llabel.preferredSize.width = 110;
            var lp = loopRow.add("checkbox", undefined, "Cycle");
            lp.value = !!states[idx].loop;

                   var cycleGrp = paramsPanel.add("group");
            cycleGrp.orientation = "column";
            cycleGrp.alignChildren = ["fill","top"];
            cycleGrp.visible = lp.value;
            addSlider(cycleGrp, "Cycle Length (s)", 0.2, 10.0, states[idx].cycle, 0.05, function(v){ states[idx].cycle = v; });

            lp.onClick = function(){
                states[idx].loop = lp.value;
                cycleGrp.visible = lp.value;
                w.layout.layout(true);
            };


            w.layout.layout(true);
        }

        dd.onChange = rebuildParams;
        ddEase.onChange = function(){
            var idx = dd.selection.index;
            states[idx].easing = ddEase.selection.text;
        };
        rebuildParams();

        divider(w);

                var btnRow = w.add("group");
        btnRow.orientation = "row";
        var btnApply = btnRow.add("button", undefined, "Apply to Selection");
        btnApply.preferredSize.height = 30;
        var btnClear = btnRow.add("button", undefined, "Clear ANNY_");
        btnClear.preferredSize.height = 30;
        btnClear.preferredSize.width = 90;
        var btnHelp = btnRow.add("button", undefined, "?");
        btnHelp.preferredSize.width = 28;


                btnApply.onClick = function(){
            var comp = getComp(); if (!comp) return;
            var sel = getSelLayers(); if (sel.length === 0) return;
            var idx = dd.selection.index;
            var anim = ANIMATIONS[idx];
            var opts = states[idx];
            var t0 = comp.time;

            app.beginUndoGroup(SCRIPT_NAME + ": " + anim.name);
            try {
                if (anim.isMulti) {
                    // Multi-layer animation: call once with whole selection
                    for (var i = 0; i < sel.length; i++) {
                        anim.apply(sel[i], opts, t0, { allLayers: sel, index: i });
                    }
                } else {
                    for (var j = 0; j < sel.length; j++) anim.apply(sel[j], opts, t0);
                }
            } catch(err) {
                alert("Error: " + err.toString());
            }
            app.endUndoGroup();
        };

                btnClear.onClick = function(){
            var comp = getComp(); if (!comp) return;
            app.beginUndoGroup(SCRIPT_NAME + ": Clear ANNY_");
            try {
                // 1) Удалить все слои с префиксом ANNY_
                var removed = 0;
                for (var i = comp.numLayers; i >= 1; i--) {
                    var L = comp.layer(i);
                    if (L.name && L.name.indexOf(LAYER_PREFIX) === 0) {
                        try { L.remove(); removed++; } catch(e){}
                    }
                }
                // 2) Снять wiggle/loopOut выражения с Position/Opacity/Scale
                //    выделенных слоёв
                var sel = comp.selectedLayers;
                var exprsCleared = 0;
                for (var s = 0; s < sel.length; s++) {
                    var propNames = ["Position", "Opacity", "Scale"];
                    for (var p = 0; p < propNames.length; p++) {
                        try {
                            var pr = sel[s].property("Transform").property(propNames[p]);
                            if (pr && pr.expression && pr.expression.length > 0) {
                                pr.expression = "";
                                exprsCleared++;
                            }
                        } catch(e){}
                    }
                }
                alert("Удалено " + removed + " слой(ёв), очищено " + exprsCleared + " выражений.");
            } catch(err) {
                alert("Clear error: " + err.toString());
            }
            app.endUndoGroup();
        };



        btnHelp.onClick = function(){ alert(getHelpText()); };

        if (w instanceof Window) { w.center(); w.show(); }
        else { w.layout.layout(true); w.layout.resize(); }
        return w;
    }

    function getHelpText() {
        return SCRIPT_NAME + " " + SCRIPT_VERSION + "\n\n" +
            "УНИВЕРСАЛЬНАЯ БИБЛИОТЕКА АНИМАЦИЙ\n" +
            "10 пресетов, применяются к любому выделенному слою.\n\n" +
            "КАК ПОЛЬЗОВАТЬСЯ:\n" +
            "  1. Выдели один или несколько слоёв.\n" +
            "  2. Установи маркер времени (CTI) в точку старта анимации.\n" +
            "  3. Выбери Animation + Easing.\n" +
            "  4. Включи Loop, если нужен циклический повтор.\n" +
            "  5. Нажми Apply to Selection.\n\n" +
            "АНИМАЦИИ:\n" +
            "  Pop In        — появление с overshoot (мягкий отскок).\n" +
            "  Fade In/Out   — плавное появление, пауза, исчезание.\n" +
            "  Slide In      — въезд из-за края (left/right/top/bottom).\n" +
            "  Glitch Reveal — рваное появление с горизонтальными сдвигами.\n" +
            "  Bounce        — пружинистая пульсация Scale.\n" +
            "  Shake         — тряска через wiggle-выражение.\n" +
            "  Slash Lines   — быстрые полосы, пролетающие поверх слоя (для\n" +
            "                  ударов, вспышек). Aux-слой ANNY_Slash_*.\n" +
            "  Pulse Glow    — пульсирующее свечение через Glow.\n" +
            "  Ripple        — волна анимации по нескольким слоям со сдвигом\n" +
            "                  по времени (stagger).\n" +
            "  Chromatic Ab. — RGB-разбиение цветовых каналов (glitch/VHS).\n" +
            "                  Aux-слои ANNY_Chroma_R_* и ANNY_Chroma_B_*.\n\n" +
            "EASING:\n" +
            "  Linear        — постоянная скорость (для механики, глитча).\n" +
            "  Ease Out      — быстрый старт, мягкое торможение (появления).\n" +
            "  Ease In/Out   — плавно в обе стороны (пульсации, дыхание).\n" +
            "  Ease Out Back — с перелётом (overshoot) в конце.\n\n" +
            "LOOP:\n" +
            "  Если включено, анимация зациклится с интервалом Cycle Length.\n" +
            "  - Появления (Pop In, Slide In, Glitch) — reset в конце цикла.\n" +
            "  - Bounce / Pulse Glow — их родной цикл через loopOut.\n" +
            "  - Shake — становится вечным wiggle-выражением.\n\n" +
            "ВСПОМОГАТЕЛЬНЫЕ СЛОИ:\n" +
            "  Некоторые эффекты создают доп. слои с префиксом '" + LAYER_PREFIX + "'.\n" +
            "  Нажми 'Clear ANNY_' чтобы удалить их все + снять wiggle-\n" +
            "  выражения с Position выделенных слоёв.\n\n" +
            "МУЛЬТИ-СЛОЙ:\n" +
            "  Все анимации кроме Ripple применяются к каждому слою одинаково.\n" +
            "  Ripple специально распределяет анимацию с задержкой по слоям.\n\n" +
            "ОГРАНИЧЕНИЯ:\n" +
            "  - Fade Out = 0 + Loop → Opacity зависнет на 100. Установи хотя\n" +
            "    бы 0.05 с для корректного цикла.\n" +
            "  - Shake с Loop не имеет автоматического выхода — очищай\n" +
            "    выражение вручную или через Clear ANNY_.\n" +
            "  - Undo (Ctrl+Z) откатывает применение полностью.";
    }


    buildUI(thisObj);

})(this);
