            buildParams: function (panel, state) {
                addSlider(panel, "Duration (s)", 0.1, 3.0, state.duration, 0.05, function(v){ state.duration = v; });
                addSlider(panel, "Intensity",    0.2, 3.0, state.intensity, 0.1, function(v){ state.intensity = v; });
                addSlider(panel, "Radius (px)",  5, 100, state.radius, 1, function(v){ state.radius = v; });
            }
        }
            ,
        {
            name: "Ripple / Stagger",
