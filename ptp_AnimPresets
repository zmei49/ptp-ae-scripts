        var rrStr   = addSlider(pRR, "Stroke:",   0.5, 10, 3, 1, "px");
        var rrRound = addSlider(pRR, "Roundness:", 0, 100, 20, 0, "px");
        var rrPad   = addSlider(pRR, "Padding:",  0, 60, 10, 0, "px");
