                    var picked = $.colorPicker();
                    if (picked !== -1){
                        var r = ((picked >> 16) & 0xFF);
                        var g = ((picked >> 8) & 0xFF);
                        var b = (picked & 0xFF);
                        function h(v){ var s = v.toString(16); return s.length<2?"0"+s:s; }
                        et.text = "#" + h(r) + h(g) + h(b);
                    }
                } catch(e){}
            };
            return et;
